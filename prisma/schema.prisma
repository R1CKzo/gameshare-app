// Schema Prisma - GameShare
// Banco: Neon (PostgreSQL Serverless)
// DATABASE_URL -> conexao via pooler do Neon (usada em runtime)
// DIRECT_URL   -> conexao direta do Neon (usada pelo Prisma Migrate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Autenticacao (NextAuth / Auth.js + Google OAuth) ----------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Dominio da aplicacao ----------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String?

  // Identificador unico: nickname + "#" + userTag (6 digitos)
  nickname  String?
  userTag   String? // 6 digitos numericos, ex: "123456"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  stream   Stream?

  // O par nickname+userTag deve ser unico no banco
  @@unique([nickname, userTag])
}

model Stream {
  id        String   @id @default(uuid())
  title     String
  isLive    Boolean  @default(false)

  // Identificador do peer WebRTC (PeerJS) usado pelo streamer para
  // receber chamadas dos espectadores
  peerId    String   @unique

  // Um canal (Stream) por usuario; isLive alterna entre ao-vivo/offline
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLive])
}
