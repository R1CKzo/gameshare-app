// Schema Prisma - GameShare
// Banco: Neon (PostgreSQL Serverless)
// DATABASE_URL -> conexao via pooler do Neon (usada em runtime)
// DIRECT_URL   -> conexao direta do Neon (usada pelo Prisma Migrate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Status de presenca. So guarda ONLINE/AWAY de verdade — "offline" nunca e
// gravado explicitamente, e inferido pela ausencia de heartbeat recente (ver
// src/lib/presence.ts) — senao a pessoa ficaria "offline" instantaneamente
// so por fechar a aba sem internet pra avisar o servidor.
enum UserStatus {
  ONLINE
  AWAY
  BUSY
}

// ---------- Autenticacao (NextAuth / Auth.js + Google OAuth) ----------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SecurityCodePurpose {
  LOGIN
  PASSWORD_CHANGE
}

// Codigo de 6 digitos enviado por email — usado tanto pra confirmar login
// por senha (sempre, a cada login) quanto pra confirmar troca/definicao de
// senha nas configuracoes. Um modelo so pras duas finalidades, pra nao
// duplicar a logica de gerar/validar/expirar em dois lugares.
model SecurityCode {
  id         String              @id @default(uuid())
  purpose    SecurityCodePurpose
  codeHash   String              // sha256 do codigo — nunca guarda em texto puro
  payload    String?             @db.Text // so PASSWORD_CHANGE: o novo hash de senha, aplicado quando o codigo bate
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Contador simples de tentativas pra limitar forca bruta (login por senha,
// reenvio de codigo) — sem Redis, uma tabela basta nessa escala.
model AuthThrottle {
  id          String    @id @default(uuid())
  key         String    @unique // ex: "login_pwd:email@x.com", "resend:{userId}"
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

// ---------- Dominio da aplicacao ----------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Hash bcryptjs da senha (login por email+senha, sem Google). Nulo =
  // conta so-Google, sem senha definida — usado pra decidir se a tela de
  // "Seguranca" mostra "Definir senha" ou "Alterar senha".
  passwordHash String?

  // Chave da ultima entrada do changelog (src/data/changelog.ts) que essa
  // pessoa ja viu — compara com a mais recente pra saber se leva pra
  // /novidades sozinho ao abrir o app. Nulo = nunca viu nenhuma.
  lastSeenChangelogKey String?

  // Status de presenca (ver PresenceProvider.tsx / src/lib/presence.ts).
  // Nulo = nunca mandou heartbeat nenhum, tratado como offline igual a um
  // heartbeat velho demais.
  status       UserStatus?
  lastActiveAt DateTime?

  // Verdadeiro quando a pessoa fixou o status manualmente no menu do
  // proprio avatar (Online/Ausente/Ocupado) — enquanto estiver assim, o
  // heartbeat automatico (foco da aba, tempo parado) para de sobrescrever
  // o status sozinho, ate ela escolher "Automatico" de novo.
  statusManual Boolean @default(false)

  // Identificador unico: nickname + "#" + userTag (6 digitos)
  nickname  String?
  userTag   String? // 6 digitos numericos, ex: "123456"

  // Acesso a area interna de bugs reportados (/admin/bugs) — nao e um
  // sistema de permissoes de verdade, so uma trava booleana pra uma unica
  // conta administradora por enquanto.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  ownedServers Server[]           @relation("ServerOwner")
  memberships  ServerMember[]
  broadcasting Channel[]          @relation("ChannelBroadcaster")
  presences    ChannelPresence[]
  messages     Message[]
  desktopLoginRequests DesktopLoginRequest[]
  serverBans   ServerBan[]
  securityCodes SecurityCode[]
  channelReads ChannelRead[]

  friendshipsSent     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived Friendship[]    @relation("FriendshipAddressee")
  dmParticipations    DMParticipant[]
  dmMessages          DMMessage[]
  dmPresences         DMPresence[]
  dmReads             DMRead[]
  dmBroadcasting      DMChannel[]     @relation("DMBroadcaster")
  bugReports          BugReport[]

  // O par nickname+userTag deve ser unico no banco
  @@unique([nickname, userTag])
}

// ---------- Bugs reportados pelos usuarios ----------

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model BugReport {
  id          String      @id @default(uuid())
  title       String
  description String
  severity    BugSeverity @default(MEDIUM)
  status      BugStatus   @default(OPEN)
  // Onde a pessoa estava e em que versao, capturado automaticamente no
  // momento do envio — evita ter que perguntar "em que tela" toda vez.
  context     String?
  appVersion  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------- Servidores (comunidades tipo Discord) ----------

model Server {
  id         String   @id @default(uuid())
  name       String
  image      String?
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  ownerId String
  owner   User   @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members  ServerMember[]
  channels Channel[]
  roles    Role[]
  bans     ServerBan[]
}

model ServerMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // Cargo opcional (um so por membro, nao varios como o Discord permite —
  // simplicidade proposital, cobre bem "tornar alguem moderador" sem
  // logica de combinar permissoes de multiplos cargos). O dono do
  // servidor nunca precisa de cargo: permissao plena vem direto de
  // Server.ownerId, checado antes mesmo de olhar isso aqui.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, serverId])
}

// Cargo customizado de um servidor, com um conjunto enxuto de permissoes
// de moderacao — cobre o que o dono realmente pediu (expulsar, banir,
// gerenciar outros cargos), sem tentar reproduzir o sistema de bitmask
// gigante do Discord.
model Role {
  id       String  @id @default(uuid())
  name     String
  color    String?
  position Int     @default(0)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  canKick           Boolean @default(false)
  canBan            Boolean @default(false)
  canManageRoles    Boolean @default(false)
  canManageChannels Boolean @default(false)

  members ServerMember[]

  @@unique([serverId, name])
  @@index([serverId])
}

// Quem foi banido de um servidor: alem de remover a pessoa (like um kick),
// impede que ela reentre pelo link de convite.
model ServerBan {
  id        String   @id @default(uuid())
  reason    String?
  createdAt DateTime @default(now())

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

enum ChannelType {
  TEXT
  CALL
}

model Channel {
  id       String      @id @default(uuid())
  name     String
  type     ChannelType
  position Int         @default(0)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // Usado apenas em canais do tipo CALL: quem esta compartilhando a tela
  // agora. O video/audio em si viaja pelas conexoes de voz (malha em
  // ChannelPresence.peerId) — isso aqui e so a flag de "quem esta
  // compartilhando" pra UI.
  isLive             Boolean   @default(false)
  broadcasterId      String?
  broadcaster        User?     @relation("ChannelBroadcaster", fields: [broadcasterId], references: [id], onDelete: SetNull)
  broadcastStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presences ChannelPresence[]
  messages  Message[]
  reads     ChannelRead[]

  @@index([serverId])
}

// Mensagem de um canal de texto. O envio dispara um evento no Pusher pro
// canal privado da sala (ver src/lib/pusher.ts) — essa tabela e so o
// historico/fonte de verdade, quem esta com a pagina aberta recebe a
// mensagem nova via WebSocket, nao ficando esperando um poll.
model Message {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Ate onde cada pessoa ja leu um canal de texto. Sem linha = "lido" (evita
// inundar todo mundo de nao-lido retroativo no dia desse recurso entrar no
// ar) — a primeira visita ao canal ja grava a leitura.
model ChannelRead {
  id         String   @id @default(uuid())
  lastReadAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

// Presenca "leve" (heartbeat) de quem esta com a sala de chamada aberta
// agora. peerId identifica o peer de audio (microfone) dessa pessoa nessa
// sala, pra quem mais estiver presente conseguir discar direto pra ela
// (malha P2P de voz) — fica nulo ate o microfone conectar de verdade.
// Auto-relatado por cada cliente (ver useVoiceMesh.getConnectionQuality),
// medido com RTCPeerConnection.getStats() de verdade contra quem ele esta
// conectado na malha — nunca um valor inventado pro servidor. GOOD e o
// padrao ate a primeira medicao chegar, pra sempre ter alguma coisa pra
// mostrar em vez de ficar em branco.
enum ConnectionQuality {
  GOOD
  MEDIUM
  BAD
}

model ChannelPresence {
  id        String   @id @default(uuid())
  updatedAt DateTime @updatedAt

  peerId            String?           @unique
  isMuted           Boolean           @default(false)
  isDeafened        Boolean           @default(false)
  connectionQuality ConnectionQuality @default(GOOD)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId, updatedAt])
}

// Login do app de desktop: o Google bloqueia o OAuth dentro de uma janela
// embutida do Electron (mesmo com o motor Chromium igual, o navegador
// "nao confiavel" e barrado), entao o app abre o navegador de verdade do
// usuario pra fazer o login e fica consultando essa tabela ate a pagina
// web confirmar "esse codigo pertence a este usuario" — so entao o app
// troca o codigo por uma sessao de verdade. code e de uso unico e some
// (deletado) assim que a janela do app troca ele pela sessao.
// ---------- Amigos e mensagens diretas ----------

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Um pedido de amizade. Enquanto PENDING, so o "addressee" (quem recebeu
// o pedido) pode aceitar; qualquer um dos dois pode cancelar/remover a
// qualquer momento (o app so tem uma linha por par, nunca duas).
model Friendship {
  id          String           @id @default(uuid())
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// Uma conversa privada entre duas pessoas (chat + chamada de voz
// opcional, tudo na mesma tela — igual DM do Discord). Reaproveita o
// mesmo desenho de Channel/Message/ChannelPresence, só que sem servidor
// dono e sempre com exatamente 2 participantes.
model DMChannel {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  participants DMParticipant[]
  messages     DMMessage[]
  presences    DMPresence[]
  reads        DMRead[]

  // Mesmo papel do Channel.isLive/broadcasterId: quem esta compartilhando
  // a tela agora nessa DM (a chamada de voz em si nao precisa disso, so
  // compartilhamento de tela tem "um dono" por vez).
  isLive             Boolean   @default(false)
  broadcasterId      String?
  broadcaster        User?     @relation("DMBroadcaster", fields: [broadcasterId], references: [id], onDelete: SetNull)
  broadcastStartedAt DateTime?

  @@index([broadcasterId])
}

model DMParticipant {
  id String @id @default(uuid())

  dmChannelId String
  dmChannel   DMChannel @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmChannelId, userId])
  @@index([userId])
}

model DMMessage {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  dmChannelId String
  dmChannel   DMChannel @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dmChannelId, createdAt])
}

// Mesma logica do ChannelRead, so que pra uma DM em vez de um canal de
// servidor.
model DMRead {
  id         String   @id @default(uuid())
  lastReadAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dmChannelId String
  dmChannel   DMChannel @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)

  @@unique([userId, dmChannelId])
}

// Mesma logica do ChannelPresence, so que pra uma DM em vez de um canal
// de servidor.
model DMPresence {
  id        String   @id @default(uuid())
  updatedAt DateTime @updatedAt

  peerId            String?           @unique
  isMuted           Boolean           @default(false)
  isDeafened        Boolean           @default(false)
  connectionQuality ConnectionQuality @default(GOOD)

  dmChannelId String
  dmChannel   DMChannel @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmChannelId, userId])
  @@index([dmChannelId, updatedAt])
}

model DesktopLoginRequest {
  id        String   @id @default(uuid())
  code      String   @unique
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
