# === Neon PostgreSQL ===
# Connection pooled (usada pela aplicacao em runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/gameshare?sslmode=require"
# Connection direta (usada pelo Prisma Migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/gameshare?sslmode=require"

# === NextAuth / Auth.js ===
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# === Google OAuth (Google Cloud Console) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === PeerJS (opcional) ===
# Se nao definido, o app usa o broker publico da nuvem PeerJS (0.peerjs.com).
# Para producao, recomenda-se hospedar seu proprio PeerServer.
NEXT_PUBLIC_PEERJS_HOST=""
NEXT_PUBLIC_PEERJS_PORT=""
NEXT_PUBLIC_PEERJS_PATH="/"
