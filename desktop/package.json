{
  "name": "gameshare-desktop",
  "version": "1.0.14",
  "description": "GameShare para Windows — cliente de desktop (Electron) que abre o app web com login do Google e checa atualizacoes sozinho.",
  "main": "main.js",
  "author": "GameShare",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.4",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "app.gameshare.desktop",
    "productName": "GameShare",
    "files": [
      "main.js",
      "main-preload.js",
      "knownGames.js",
      "wait.html",
      "splash.html",
      "splash-preload.js",
      "build/icon.ico",
      "build/icon-badge.ico",
      "build/dot-badge.png"
    ],
    "extraResources": [
      {
        "from": "loopback_helper.exe",
        "to": "loopback_helper.exe"
      },
      {
        "from": "build-info.json",
        "to": "build-info.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GameShare-Setup.exe",
      "shortcutName": "GameShare",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "R1CKzo",
      "repo": "gameshare-app",
      "releaseType": "release"
    }
  }
}
