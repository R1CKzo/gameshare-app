{
  "appId": "app.gameshare.desktop.testui",
  "productName": "GameShare Teste",
  "extraMetadata": { "name": "gameshare-desktop-testui" },
  "files": [
    "main.js",
    "main-preload.js",
    "wait.html",
    "build/icon.ico",
    "build/icon-badge.ico",
    "build/dot-badge.png"
  ],
  "extraResources": [
    { "from": "loopback_helper.exe", "to": "loopback_helper.exe" },
